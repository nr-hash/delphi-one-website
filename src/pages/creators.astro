---
// For Creators: la página "For Creators" del artifact de diseño, armada con los componentes de la Home.
// Mismo orden de secciones que el artifact: hero, Valuations, Max Distills, Views, newsletter,
// model portfolio, Olives, D1 seat, ganancias, personas y cierre.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroStatic from '../components/HeroStatic.astro';
import What from '../components/What.astro';
import Valuations from '../components/Valuations.astro';
import ImportCard from '../components/ImportCard.astro'; // la versión con la pantalla: Import.astro
import Views from '../components/Views.astro';
import Newsletter from '../components/Newsletter.astro';
import Rail from '../components/Rail.astro';
import Win from '../components/Win.astro';
import Earn from '../components/Earn.astro';
import Personas from '../components/Personas.astro';
import ManyApps from '../components/ManyApps.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Delphi One for Creators — Be the #1 analyst on your asset"
  description="Lead the asset you know best: be the first analyst its investors see, and get paid when they trade on your ideas."
>
  <a class="skip" href="#main">Skip to content</a>
  <Header page="creators" />
  <main id="main" class="pg-creators pg-site" tabindex="-1">
    <HeroStatic />
    <What />
    <Valuations
      title="Your stock and crypto deep dives, as living Valuations"
      sub="On Substack, a deep dive is frozen the day you publish it. Here you curate the best Views, Articles and Posts, yours or other analysts’, into your Valuation, and keep it current as your thinking changes."
      link={false}
    />
    <ImportCard />
    <Views />
    <Newsletter />
    <Rail
      id="mf"
      pair
      title="Your model portfolio, live for your members to Replicate"
      lede="Run it from your own wallet, created when you sign up, with real money in any amount: members Replicate your allocations, not your position sizes."
      cards={[
        { title: 'Followers get an alert on every move', body: 'Following is free, but Replicating it in one click takes a membership.', img: 'pf_readers2.jpg', pos: '50% 0' },
        { title: 'A membership worth paying for', body: 'Replication is something Substack can’t offer: your members get your exact allocations in one click, instead of copying you trade by trade. That makes your membership far easier to sell, at the price you set.', img: 'pf_membership.jpg', pos: '50% 50%' },
      ]}
    />
    <Rail
      id="olives"
      pair
      title="Rewarded for how you think"
      lede="We never judge your portfolio against a benchmark. That breeds closet indexing, hype and performance chasing. Olives mostly reward how you reason, how you engage with others and how often other analysts build on your work."
      cards={[
        { title: 'Work others build on', body: 'When other analysts vote on your Views, curate your Arguments or build your work into their Valuations, you earn Olives.', img: 'hiw3_curations.jpg', pos: '0 0', ntf: '<div class="ntf ntf-olives" aria-hidden="true"><div class="ntf-hd"><b>Notifications</b><span>Mark all as read</span></div><div class="ntf-it new"><img src="/images/v2/ntf_joe.jpg" alt="" loading="lazy" decoding="async"><div><p>Joe Delphi added your debate to Curations</p><small>“Bitcoin is better than gold”</small></div><div class="ntf-r"><time>1h</time><span class="ntf-chip">BTC<img src="/images/v2/i_btc.svg" alt="" loading="lazy" decoding="async"></span></div></div></div>' },
        { title: 'Earned asset by asset', body: 'Olives are earned and shown per asset, so investors can see exactly where your expertise lies.', img: 'tx_olives.jpg', pos: '0 100%' },
      ]}
    />
    <Win />
    <Earn />
    <Personas page="creators" />
    <ManyApps page="creators" />
  </main>
  <Footer page="creators" />
</Layout>

<script>
  import '../scripts/landing.js';
</script>
