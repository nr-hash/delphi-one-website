---
/* Layout base: <head> + <body>, same structure as beta.delphi.one.
   - Un solo CSS global (src/styles/global.css), copiado del artifact de diseño sin
     las herramientas de edición: las clases del markup son las del artifact.
   - El bloque de meta replica el de beta (SEO, OG, Twitter, JSON-LD).
   - Analytics (GA4 + Clarity) sólo en el build de producción, cargados después
     de la primera interacción o del load, como en beta. */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Imagen OG absoluta o relativa al sitio (1200x630). */
  image?: string;
  /** Agrega `noindex` (páginas de prueba, previews). */
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title = 'Delphi One — Investment Alpha, Distilled',
  description = 'Share your investment views on the cryptos and stocks you follow, and get rewarded for sharp reasoning — not lucky price calls.',
  image = 'https://delphi.one/og_2026_v2.png',
  noindex = false,
  bodyClass = 'has-hero-scroll',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const analytics = import.meta.env.PROD;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Delphi One',
  url: 'https://delphi.one',
  logo: 'https://delphi.one/delphi-one-logo.svg',
  description:
    'Investment Alpha, Distilled — an investment research platform where analysts publish Views, build Valuations and get read first on their asset',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={robots} />
  <meta name="bingbot" content={robots} />
  <meta name="author" content="Delphi One" />
  <meta name="keywords" content="investment research, valuations, views, analysts, stocks, crypto" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Delphi One" />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonical} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  {analytics && (
    <script is:inline>
      (function () {
        var started = false;
        function start() {
          if (started) return;
          started = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", "G-J386F4YV1J");
          var ga = document.createElement("script");
          ga.async = true;
          ga.src = "https://www.googletagmanager.com/gtag/js?id=G-J386F4YV1J";
          document.head.appendChild(ga);
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "riza6fip09");
        }
        if (document.readyState === "complete") start();
        else window.addEventListener("load", start, { once: true });
        ["pointerdown", "keydown", "scroll"].forEach(function (ev) {
          window.addEventListener(ev, start, { once: true, passive: true });
        });
      })();
    </script>
  )}
  <!-- the hero artboard stays hidden until the script has scaled it (see .hero-loading in global.css) -->
  <script is:inline>document.documentElement.classList.add('hero-loading');setTimeout(function(){document.documentElement.classList.remove('hero-loading')},2000);</script>
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
