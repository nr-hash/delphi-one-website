---
// #import (variante banner) — "Already wrote it?": Max Distills como banner ancho, blanco y gris,
// del ancho de la composición de Valuations (--val-sw, lo publica fitStages). A la izquierda el
// título, la bajada, tres puntos y un botón (Distill your content); a la derecha una ventana que asoma desde
// abajo con el borrador de Valuation que arma Max. La versión con la pantalla sigue en Import.astro.
const REG = 'https://app.delphi.one/?nav=login&snav=register';
const FILE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M12 18v-6M9.5 14.5 12 12l2.5 2.5"></path></svg>';
const UPLOAD = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V4M7.5 8.5 12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path></svg>';
const MARK = '<svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg>';
const CHECK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"></path></svg>';
---
<section class="sec" id="import"><div class="wrap"><h2 class="sr-only">Already wrote it?</h2>
<div class="mxb rv">
  <div class="mxb-copy">
    <h3 class="mxb-t">Already wrote it? Then the hard part is done.</h3>
    <p class="mxb-s">Max Distills turns your deep dive into a draft Valuation in one click. You just review it.</p>
    <ul class="mxb-pts">
      <li><span set:html={CHECK}></span>Upload a PDF or paste a link to your deep dive</li>
      <li><span set:html={CHECK}></span>A full draft, from your own work</li>
      <li><span set:html={CHECK}></span>Nothing goes out unapproved</li>
    </ul>
    <a class="mxb-btn" href={REG}><span class="ic" set:html={UPLOAD}></span>Distill your content</a>
  </div>
  <div class="mxb-dev" aria-hidden="true">
    <div class="wbar"><i></i><i></i><i></i></div>
    <div class="mxb-max"><img src="/images/v2/max_distills.png" alt="" width="30" height="32" loading="lazy" decoding="async" /><b>Max Distills</b><span class="tag">EXPERIMENTAL</span></div>
    <div class="mxb-src"><span class="ic" set:html={FILE}></span>Deep-dive.pdf<span class="ok">Distilled</span></div>
    <div class="vcard">
      <div class="vtop"><span class="as">Draft Valuation · Gold · IAU</span><span class="val"><small>VALUE</small>$68.40</span></div>
      <div class="vt">Gold still has room to run</div>
      <div class="ln" style="--w:100%"></div><div class="ln" style="--w:88%"></div><div class="ln" style="--w:64%"></div>
      <div class="vchips"><span class="vc view"><span class="bi" set:html={MARK}></span>4 Views</span><span class="vc post"><span class="bi" set:html={MARK}></span>2 Posts</span></div>
    </div>
    <div class="mxb-cap">Ready for you to review</div>
  </div>
</div></div></section>
