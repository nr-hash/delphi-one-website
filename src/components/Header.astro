---
// Header fijo: ticker (precios vivos vía /api/ticker), logo, menú de anclas y CTA.
// Un solo menú para todo el sitio. En /creators (page="creators") las anclas vuelven a su sección de
// la Home (/#how…) y "FOR CREATORS" queda marcado como la página actual.
interface Props { page?: 'home' | 'creators' }
const { page = 'home' } = Astro.props;
const REG = 'https://app.delphi.one/?nav=login&snav=register';
const home = (h: string) => (page === 'home' ? h : `/${h}`);
const NAV: [string, string, string?][] = [[home('#hero'), 'HOME'], [home('#mf-val'), 'VALUATIONS'], [home('#trade'), 'TRADE'], [home('#mf'), 'PORTFOLIO'], [home('#plans'), 'PLANS'], ['/creators', 'FOR CREATORS', 'nav-switch']];
const CTA = 'Get started with';
---
<header class="hdr" id="hdr">
  <div class="ticker" aria-hidden="true"><div class="tk-track"><span class="tk-item" data-sym="BTC"><img src="/images/v2/i_btc.svg" alt="" loading="lazy" decoding="async"><span class="tk-sym">BTC</span><span class="tk-px">$117,320.00</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="ETH"><img src="/images/v2/i_eth.svg" alt="" loading="lazy" decoding="async"><span class="tk-sym">ETH</span><span class="tk-px">$4,512.00</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="TSLA"><img src="/images/v2/i_tsla.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">TSLA</span><span class="tk-px">$412.50</span><span class="tk-dir down">↓</span></span><span class="tk-item" data-sym="NVDA"><img src="/images/v2/i_nvda.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">NVDA</span><span class="tk-px">$178.20</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="SOL"><img src="/images/v2/i_sol.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">SOL</span><span class="tk-px">$236.40</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="XRP"><img src="/images/v2/i_xrp.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">XRP</span><span class="tk-px">$3.02</span><span class="tk-dir down">↓</span></span><span class="tk-item" data-sym="BTC"><img src="/images/v2/i_btc.svg" alt="" loading="lazy" decoding="async"><span class="tk-sym">BTC</span><span class="tk-px">$117,320.00</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="ETH"><img src="/images/v2/i_eth.svg" alt="" loading="lazy" decoding="async"><span class="tk-sym">ETH</span><span class="tk-px">$4,512.00</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="TSLA"><img src="/images/v2/i_tsla.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">TSLA</span><span class="tk-px">$412.50</span><span class="tk-dir down">↓</span></span><span class="tk-item" data-sym="NVDA"><img src="/images/v2/i_nvda.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">NVDA</span><span class="tk-px">$178.20</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="SOL"><img src="/images/v2/i_sol.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">SOL</span><span class="tk-px">$236.40</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="XRP"><img src="/images/v2/i_xrp.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">XRP</span><span class="tk-px">$3.02</span><span class="tk-dir down">↓</span></span><span class="tk-item" data-sym="BTC"><img src="/images/v2/i_btc.svg" alt="" loading="lazy" decoding="async"><span class="tk-sym">BTC</span><span class="tk-px">$117,320.00</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="ETH"><img src="/images/v2/i_eth.svg" alt="" loading="lazy" decoding="async"><span class="tk-sym">ETH</span><span class="tk-px">$4,512.00</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="TSLA"><img src="/images/v2/i_tsla.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">TSLA</span><span class="tk-px">$412.50</span><span class="tk-dir down">↓</span></span><span class="tk-item" data-sym="NVDA"><img src="/images/v2/i_nvda.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">NVDA</span><span class="tk-px">$178.20</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="SOL"><img src="/images/v2/i_sol.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">SOL</span><span class="tk-px">$236.40</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="XRP"><img src="/images/v2/i_xrp.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">XRP</span><span class="tk-px">$3.02</span><span class="tk-dir down">↓</span></span><span class="tk-item" data-sym="BTC"><img src="/images/v2/i_btc.svg" alt="" loading="lazy" decoding="async"><span class="tk-sym">BTC</span><span class="tk-px">$117,320.00</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="ETH"><img src="/images/v2/i_eth.svg" alt="" loading="lazy" decoding="async"><span class="tk-sym">ETH</span><span class="tk-px">$4,512.00</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="TSLA"><img src="/images/v2/i_tsla.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">TSLA</span><span class="tk-px">$412.50</span><span class="tk-dir down">↓</span></span><span class="tk-item" data-sym="NVDA"><img src="/images/v2/i_nvda.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">NVDA</span><span class="tk-px">$178.20</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="SOL"><img src="/images/v2/i_sol.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">SOL</span><span class="tk-px">$236.40</span><span class="tk-dir up">↑</span></span><span class="tk-item" data-sym="XRP"><img src="/images/v2/i_xrp.webp" alt="" loading="lazy" decoding="async"><span class="tk-sym">XRP</span><span class="tk-px">$3.02</span><span class="tk-dir down">↓</span></span></div></div>
  <div class="hdr-row wrap">
    <a class="brand" href="/" aria-label="Delphi One home"><img src="/images/v2/logo.svg" alt="Delphi One" class="logo" loading="eager" decoding="async"><span class="alpha">BETA</span></a>
    <nav class="nav" id="nav">{NAV.map(([href, label, cls], i) => <a href={href} class={cls} aria-current={page === 'creators' && href === '/creators' ? 'page' : undefined} style={`animation-delay:${i * 40}ms`}><span data-t={label}>{label}</span></a>)}<a class="nav-cta" href={REG} target="_blank" rel="noopener" style={`animation-delay:${NAV.length * 40}ms`}><span>{CTA}</span> <img src="/images/v2/x_white.svg" alt="X" loading="lazy" decoding="async"></a></nav>
    <a class="hdr-cta" href={REG} target="_blank" rel="noopener"><span>{CTA}</span> <img src="/images/v2/x_white.svg" alt="X" loading="lazy" decoding="async"></a>
    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav"><svg width="18" height="18" viewBox="0 0 18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 5h14M2 9h14M2 13h14"></path></svg></button>
  </div></header>
