---
// #mf-val — Valuations: composición de Figma escalada a la columna (.stagebox, fitStages).
// El link a creadores vive en el encabezado, debajo de la bajada que habla de los analistas.
// Drop del Article: .vb-drop tapa la parte baja de la captura (línea verde horneada) y reusa la misma imagen
// para la fila del ETF y el último párrafo; al soltar el chip aparece la fila del Article y empuja el resto.
// Props: el encabezado cambia por página (en /creators no lleva el link a creadores); la composición es la misma.
interface Props { title?: string; sub?: string; link?: boolean }
const {
  title = 'Big ideas, built from small ones',
  sub,
  link = true,
} = Astro.props;
const HOME_SUB = `Analysts build Valuations from bite-sized Views, Delphi One’s signature: an idea in 80 characters or less that comes with its <span class="nowrap">counter-View</span>, each side backed by Arguments. Analysts curate the best Views, Posts and Articles into their Valuations.`;
---
<section class="sec" id="mf-val"><div class="wrap"><div class="mf-head rv"><h2 class="h2">{title}</h2><p class="sub">{sub ? sub : <Fragment set:html={HOME_SUB} />}</p>{link && (<a class="mf-link" href="/creators"><span>Are you an analyst? Get paid for your <span class="nowrap">Valuations&nbsp;<span class="arr" aria-hidden="true">→</span></span></span></a>)}</div><div class="stagebox" data-w="1200" data-h="560" data-fit="screen" data-trim="10"><div class="stage" style="width:1200px;height:560px"><svg class="vb-lines" aria-hidden="true" width="1200" height="600" viewBox="0 0 1200 600">
    <path d="M218 100 C260 100 262 170 302 170"></path><path d="M262 270 C285 270 280 260 302 260"></path><path d="M210 460 C260 460 262 420 302 420"></path>
    <path d="M982 77 C940 77 942 150 902 150"></path><path d="M939 270 C920 270 920 262 902 262"></path><path d="M992 443 C950 443 942 420 902 420"></path></svg><div class="mock wide" style="left:302px;top:10px;width:600px;"><img src="/images/v2/vb_window.webp" alt={`Delphi One app screenshot: ${title}`} style="width:600px;border-radius:14px" loading="lazy" decoding="async" /><div class="vb-drop" aria-hidden="true"><i class="vb-line"></i><div class="vb-row"><span class="ic"><svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg></span><span class="tx">Quantum computers pose no near-term threat to Bitcoin</span><svg class="chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5 10.5 8 6 12.5"></path></svg></div><div class="vb-rest"></div></div></div><div class="bm view" data-chip="v1" aria-hidden="true" style="left:28px;top:70px;animation-delay:-1s"><span class="bi"><svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg></span>View 1</div><div class="bm view" data-chip="v2" aria-hidden="true" style="left:72px;top:240px;"><span class="bi"><svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg></span>View 2</div><div class="bm view" data-chip="v3" aria-hidden="true" style="left:20px;top:430px;"><span class="bi"><svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg></span>View x</div><div class="bm post" data-chip="p1" aria-hidden="true" style="left:982px;top:47px;"><span class="bi"><svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg></span>Post 1</div><div class="bm post" data-chip="p2" aria-hidden="true" style="left:939px;top:240px;"><span class="bi"><svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg></span>Post 2</div><div class="bm post" data-chip="p3" aria-hidden="true" style="left:992px;top:413px;"><span class="bi"><svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg></span>Post x</div><div class="bm art" data-chip="art" aria-hidden="true" style="left:722px;top:386px;"><span class="bi"><svg viewBox="0 0 10 12"><path d="M1 1h8v10L5 8.3 1 11z" fill="currentColor"></path></svg></span>Article</div><div class="cursor" data-chip="cur" aria-hidden="true" style="left:878px;top:426px;"><svg width="20" height="22" viewBox="0 0 20 22"><path d="M2 1l15 9.5-6.6 1.4L7.3 19z" fill="#fff" stroke="#10171e" stroke-width="1.5" stroke-linejoin="round"></path></svg></div></div></div></div></section>
