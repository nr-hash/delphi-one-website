<!-- ============================================================
     SECTION 4: HOW IT WORKS — STICKY REVEAL
     Reemplaza a la versión con tabs.

     Desktop: dos columnas. A la izquierda los pasos apilados, cada uno
     de ~62vh y centrado, así siempre hay exactamente uno sobre la línea
     media del viewport: ese queda activo y el resto se atenúa (el texto
     sigue visible). A la derecha, un panel sticky que se queda quieto
     mientras pasan los pasos y hace cross-fade al visual del activo.
     El scroll corre a velocidad normal — no se secuestra.
     Mobile: sin sticky; cada paso lleva su visual debajo.
     ============================================================ -->
<section id="how-it-works" data-section="how-it-works-parallax">

  <!-- Section intro: heading + subheading -->
  <div class="container hiwp-intro">
    <p class="hiwp-eyebrow">How it works</p>
    <h2>How to distill alpha — for your firm, your clients, or your followers.</h2>
    <p class="hiwp-sub">
      Share your investment views, premises, or straight-up banter on your favorite
      cryptos and stocks. Get rewarded for sharp reasoning—not lucky price calls.
    </p>
  </div>

  <div class="container hiwp-layout">

    <!-- Left: the steps. Todo el texto siempre visible; el activo es el
         que cruza la línea media del viewport. -->
    <ol class="hiwp-steps">

      <li class="hiwp-step" data-hiwp-step data-index="0" data-active="true">
        <p class="hiwp-step-num">1.</p>
        <h3 class="hiwp-step-title">Pick your asset</h3>
        <p class="hiwp-step-lead">Start where you already have an edge.</p>
        <ul class="hiwp-step-list">
          <li>Equities or crypto — cover what you actually follow</li>
          <li>One you know cold, not one you can only guess at</li>
          <li>Begin with a single ticker and widen from there</li>
        </ul>
        <div class="hiwp-step-visual">
          <!-- Mismo video que el panel de la derecha; en desktop este
               bloque no se muestra (lo tapa el sticky). -->
          <video data-hiwp-video
                 src="/how-it-works-step-1.mp4"
                 poster="/how-it-works-step-1.jpg"
                 muted loop playsinline preload="metadata"
                 aria-hidden="true"></video>
        </div>
      </li>

      <li class="hiwp-step" data-hiwp-step data-index="1">
        <p class="hiwp-step-num">2.</p>
        <h3 class="hiwp-step-title">Separate what matters from what doesn't</h3>
        <p class="hiwp-step-lead">Signal is whatever survives scrutiny.</p>
        <ul class="hiwp-step-list">
          <li>Bookmark the Facts and Views worth keeping — yours and other analysts&rsquo;</li>
          <li>Judge them, and let others judge yours</li>
          <li>Put your reasoning in front of people who read the asset differently</li>
        </ul>
        <q class="hiwp-row-quote">When the facts change, I change my mind. What do you do?</q>
        <div class="hiwp-step-visual">
          <!-- Mismo video que el panel de la derecha; en desktop este
               bloque no se muestra (lo tapa el sticky). -->
          <video data-hiwp-video
                 src="/how-it-works-step-2.mp4"
                 poster="/how-it-works-step-2.jpg"
                 muted loop playsinline preload="metadata"
                 aria-hidden="true"></video>
        </div>
      </li>

      <li class="hiwp-step" data-hiwp-step data-index="2">
        <p class="hiwp-step-num">3.</p>
        <h3 class="hiwp-step-title">Turn conviction into a Valuation</h3>
        <p class="hiwp-step-lead">Our AI does the connective work, so your thinking arrives clean.</p>
        <ul class="hiwp-step-list">
          <li>The prose between your ideas, the structure, the layout — handled</li>
          <li>Subscribers spend attention on your reasoning, not your formatting</li>
          <li>Already publishing elsewhere or posting on X? Import it and see how it reads here</li>
        </ul>
        <div class="hiwp-step-visual">
          <!-- Mismo video que el panel de la derecha; en desktop este
               bloque no se muestra (lo tapa el sticky). -->
          <video data-hiwp-video
                 src="/how-it-works-step-3.mp4"
                 poster="/how-it-works-step-3.jpg"
                 muted loop playsinline preload="metadata"
                 aria-hidden="true"></video>
        </div>
      </li>

      <li class="hiwp-step" data-hiwp-step data-index="3">
        <p class="hiwp-step-num">4.</p>
        <h3 class="hiwp-step-title">Build a reputation. Then monetize it</h3>
        <p class="hiwp-step-lead">Rank as a founding analyst on the assets you cover.</p>
        <ul class="hiwp-step-list">
          <li>Grow a following of retail and institutional investors</li>
          <li>Keep them current as your Valuation moves with the news, the debates, the macro</li>
          <li>A track record that compounds — and pays</li>
        </ul>
        <div class="hiwp-step-visual">
          <!-- Mismo video que el panel de la derecha; en desktop este
               bloque no se muestra (lo tapa el sticky). -->
          <video data-hiwp-video
                 src="/how-it-works-step-4.mp4"
                 poster="/how-it-works-step-4.jpg"
                 muted loop playsinline preload="metadata"
                 aria-hidden="true"></video>
        </div>
      </li>
    </ol>

    <!-- Right: visual sticky, sin marco. Hace cross-fade al paso activo.
         Duplica los visuales de la izquierda, así que va oculto para
         lectores de pantalla. -->
    <div class="hiwp-aside" aria-hidden="true">
      <div class="hiwp-sticky">
        <div class="hiwp-visual">
          <div class="hiwp-panel" data-hiwp-panel data-index="0" data-active="true">
            <!-- ============================================================
                 PASO 1 — "Pick your asset". Captura real del selector de
                 activo, 1440x1080 (4:3, el ratio del slot).
                 El loop y el play/pause por visibilidad los pone
                 hiwp-video.js; acá no hay autoplay a propósito.
                 ============================================================ -->
            <video data-hiwp-video
                   src="/how-it-works-step-1.mp4"
                   poster="/how-it-works-step-1.jpg"
                   muted loop playsinline preload="metadata"
                   aria-hidden="true"></video>
          </div>
          <div class="hiwp-panel" data-hiwp-panel data-index="1">
            <!-- ============================================================
                 PASO 2 — "Separate what matters from what doesn't". Captura
                 real del bookmark de una View, 1440x1080 (4:3, el ratio del
                 slot). El loop y el play/pause por visibilidad los pone
