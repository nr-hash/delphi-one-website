                 ============================================================ -->
            <video data-hiwp-video
                   src="/how-it-works-step-3.mp4"
                   poster="/how-it-works-step-3.jpg"
                   muted loop playsinline preload="metadata"
                   aria-hidden="true"></video>
          </div>
          <div class="hiwp-panel" data-hiwp-panel data-index="3">
            <!-- ============================================================
