---
// #many — Cierre. Home: "Many apps for prices…"; /creators: "Claim your asset before someone else does".
// Sólo cambia el contenido (título, bajada, checks y botón); el markup es el mismo en las dos páginas.
interface Props { page?: 'home' | 'creators' }
const { page = 'home' } = Astro.props;
const CR = page === 'creators';
const H2_HOME = '<span>Many apps for prices.</span><br><span class="sr-only">One for values.</span><span class="l2" aria-hidden="true"><img src="/images/v2/glyph.svg" alt="" loading="lazy" decoding="async"><span>ne for values.</span></span>';
const H2_CREATORS = '<span>Claim your asset</span><br><span class="l2"><span>before someone else does</span></span>';
const CHECKS = CR
  ? ['Every creator tool free while in alpha', 'Keep publishing wherever you already do', 'Keep 90% of your membership price']
  : ['Get Premium free while in alpha', 'Pick your analysts before the crowd finds them', 'Help shape what Delphi One becomes', 'Creators: get a head start on becoming the top analyst on your favorite assets'];
const CHECK = '<svg viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="7" fill="#0ea05d"></circle><path d="M4 7.2l2 2 4-4.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---
<section class="many" id="many"><div class="wrap rv">
   <h2 set:html={CR ? H2_CREATORS : H2_HOME} /><p class="s">{CR ? 'Each asset has one D1 seat. Claim yours early, and everyone after you has to out-reason you.' : 'Investment alpha, distilled.'}</p>
   <div><ul class="checks">{CHECKS.map(t => <li><Fragment set:html={CHECK} /><span>{t}</span></li>)}</ul></div>
   <a class="btn-dark" href="https://app.delphi.one/?nav=login&amp;snav=register" target="_blank" rel="noopener"><span>{CR ? 'Join as a creator with' : 'Get started with'}</span> <img src="/images/v2/x_white.svg" alt="X" loading="lazy" decoding="async"></a></div></section>
