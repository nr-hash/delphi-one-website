---
// #what — "What is Delphi One?" (For Creators): the What is section of the design artifact (split head:
// title on the left, text on the right; .acard cards with a line icon, title, text and "Learn more →").
// Its CSS was already in global.css (.split-head, .cards3, .acard, .more, .pg-site #what).
// The text takes the hero's subheading as its starting point; the cards are Valuations, Newsletter and
// Portfolio, each linking to its section further down the page. Copy to be reviewed.
const ICON = (path: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="#10171e" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;
const CARDS = [
  {
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>', // chart
    title: 'Valuations',
    body: 'Your deep dives stay current: members see your Value, its Views and counter-Views, and every update.',
    href: '#mf-val',
  },
  {
    icon: '<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M9 13h6M9 17h6"/>', // file
    title: 'Newsletter',
    body: 'Write as many Articles as you like and send them to your members by email, just as on Substack, and curate the best into your Valuations.',
    href: '#newsletter',
  },
  {
    icon: '<path d="M21 12A9 9 0 1 1 12 3v9z"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15z"/>', // pie
    title: 'Portfolio',
    body: 'On Substack, members read about your portfolio. Here they hold it, with one click to Replicate and an alert on every move: one more reason to pay for your membership.',
    href: '#mf',
  },
];
---
<section class="sec" id="what"><div class="wrap">
  <div class="split-head rv"><h2 class="h2">What is Delphi One?</h2><p>Your newsletter lives on Substack, your takes on X and your portfolio at a broker. Delphi One is a marketplace for investment ideas that brings all of it together, where your members can act on every idea you publish.</p></div>
  <div class="cards3">
    {CARDS.map((c, i) => (
      <article class="acard rv" style={`transition-delay:${i * 80}ms`}>
        <div class="ico"><Fragment set:html={ICON(c.icon)} /></div>
        <h3>{c.title}</h3>
        <p>{c.body}</p>
        <a class="more" href={c.href}>Learn more →</a>
      </article>
    ))}
  </div>
</div></section>
