---
// #personas — Which one are you?: selector de lado + cards (setupCaseSwitch) y un CTA por lado (.case-lab).
// Un solo elenco de seis, igual en las dos páginas (cada nombre con su cara y su texto). `page` sólo
// cambia el orden y los CTA: la Home abre con "I'm an Investor"; /creators abre con "I'm a Creator".
interface Props { page?: 'home' | 'creators' }
const { page = 'home' } = Astro.props;
const REG = 'https://app.delphi.one/?nav=login&snav=register';
type Card = { av: string; pos: string; name: string; desc: string; body: string; n: string };
type Side = { tab: string; cards: Card[]; cta: { href: string; label: string; external?: boolean } };

const INVESTORS: Card[] = [
  { av: 'av2_marcus.jpg', pos: '50% 50%', name: 'Marcus', desc: 'The Loyal Reader', n: '3', body: 'Marcus pays for three investment newsletters and has a favorite, but he only ever hears one side of the argument. When that analyst joins Delphi One, Marcus follows. Now the ideas come with a Value, a counter-View and Olives, and the analyst’s model portfolio is one click away.' },
  { av: 'av3', pos: '63% 32%', name: 'Miles', desc: 'The Committee of One', n: '6', body: 'Miles has run his own money for twenty years, and every call is his alone. What he misses is the room: analysts pitching ideas, someone arguing the other side. On Delphi One he picks his analysts, hears their pitches and makes the call.' },
  { av: 'av4_lucia.jpg', pos: '50% 50%', name: 'Lucía', desc: 'The Crypto Skeptic', n: '4', body: 'Lucía holds crypto and has followed enough confident voices on X to know talk is cheap. Here every analyst’s portfolio is built from real trades on-chain, and every idea comes with its counter-View. She reads the bear case before she buys.' },
];
const CREATORS: Card[] = [
  { av: 'av1_harry.jpg', pos: '50% 50%', name: 'Harry', desc: 'The Newsletter Veteran', n: '1', body: 'Harry has written a paid Substack for years, and his subscribers renew. What he can’t show new readers is why: there’s no record, only his word. Here his reasoning is public, judged by Olives and checkable in a minute, and he offers it in memberships at his own price.' },
  { av: 'av5', pos: '55% 0', name: 'Kai', desc: 'The Crypto Voice', n: '5', body: 'Kai covers Solana on X and people keep asking what he holds. X can’t give him a title: there’s no #1 on Solana there. Here there’s exactly one, it goes to reasoning, not volume, and his members can Replicate his portfolio in one click.' },
  { av: 'av6', pos: '85% 0', name: 'Jane', desc: 'The Portfolio Creator', n: '2', body: 'Jane shares her model portfolio in a monthly post, and her readers copy it trade by trade, always a step behind. Here members Replicate it in one click and get an alert on every move, so her membership sells itself.' },
];
const INV: Side = { tab: "I'm an Investor", cta: { href: REG, label: 'Pick your analysts', external: true }, cards: INVESTORS };
const CRE: Side = page === 'creators'
  ? { tab: "I'm a Creator", cta: { href: 'mailto:info@delphi.one?subject=Migrate%20my%20content%20to%20Delphi%20One', label: 'Ask us to migrate your content' }, cards: CREATORS }
  : { tab: "I'm a Creator", cta: { href: '/creators', label: 'See how you get paid →' }, cards: CREATORS };
const SIDES = page === 'creators' ? [CRE, INV] : [INV, CRE];
---
<section class="sec" id="personas"><div class="wrap"><div class="intro rv"><h2 class="h2">Which one are you?</h2></div>
    <div class="cs rv"><div class="cs-switch" id="caseSwitch" role="tablist" aria-label="Which one are you?" style="--x:0"><span class="cs-ind"></span>{SIDES.map((sd, i) => <button class="cs-opt" role="tab" id={`cs-tab-${i}`} aria-controls={`cs-pane-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? '0' : '-1'}><span class="cs-t">{sd.tab}</span></button>)}</div>
    {SIDES.map((sd, i) => <div class={i === 0 ? 'cs-pane on' : 'cs-pane'} hidden={i !== 0} role="tabpanel" id={`cs-pane-${i}`} aria-labelledby={`cs-tab-${i}`} tabindex="0"><div class="cs-grid">{sd.cards.map(c => <article class="pcard"><div class="phead"><img src={c.av.includes('.') ? `/images/v2/${c.av}` : `/images/v2/${c.av}.webp`} alt="" style={`object-position:${c.pos}`} loading="lazy" decoding="async" /><div class="pname"><h3>{c.name}</h3><div class="pdesc">{c.desc}</div></div></div><p>{c.body}</p><a class="ptry" href={REG} target="_blank" rel="noopener"><span>Try the app as</span> <span data-name={c.n}>{c.name}</span><span class="arr" aria-hidden="true">→</span></a></article>)}</div></div>)}<div class="center-btn case-go">{SIDES.map(sd => sd.cta.external ? <a class="btn-dark case-lab" href={sd.cta.href} target="_blank" rel="noopener"><span>{sd.cta.label}</span></a> : <a class="btn-dark case-lab" href={sd.cta.href}><span>{sd.cta.label}</span></a>)}</div></div></div></section>
